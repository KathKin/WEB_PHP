{% extends "__layout.twig" %}
{% from "btn.twig" import btn%}
{% block content %}
<div style="display: flex; justify-content: space-around; " class="row row-cols-5 g-4">
{% for object in m_s %}

    <div class="card h-100" style="border: 2px solid rgb(222, 222, 222);">
      
      <div class="position-absolute" style="right: 4px; top: 4px;">
        <form action="/m_s/delete" method="POST">
          <input type="hidden" name="id" value="{{object.id}}">
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-times"></i>
          </button>
        </form>
      </div>

      <div class="position-absolute" style="right: 4px; top: 50px;">
        <form action="/m_s/{{object.id}}/edit">
          <input type="hidden" name="id" value="{{object.id}}">
          <button type="submit" class="btn btn-primary">
            <i class="fa-regular fa-pen-to-square"></i>
          </button>
        </form>
      </div>

      <div style="width: 100%;">
        <img src="{{object.image}}" class="card-img-top" alt="" style="height: 250px; object-fit: cover;">
      </div>
      <div style="width: 100% ;">
          {{ btn(object.title, "/m_s/" ~ object.id, true)}}
          
        <div style="display: flex;">
          {{ btn("Картинка", "/m_s/" ~ object.id ~ "?show=image" , false)}}
          {{ btn("Описание","/m_s/" ~ object.id ~ "?show=info", false)}}
        </div>        
      </div>


    </div>
{% endfor %}
</div>
{% endblock %}