{% extends "__layout.twig" %}
{% from "btn.twig" import btn%}
{% block content %}
<h4>Сообщение из сессии: {{message}} </h4>
<h4>Последние сообщения: 
  {% for m in messages %}
    {{m}} <br>
  {% endfor %}
</h4>
<br>
<h1>{{title}}</h1>

<h3>{{description}}</h3>
<ul class="nav nav-pills">
  <li class="nav-item">
    {{ btn("Картинка","/m_s/" ~ id ~ "?show=image", is_image)}}
  </li>
  <li class="nav-item">
    {{ btn("Описание", "/m_s/" ~ id ~ "?show=info", is_info)}}
  </li>
</ul>
<div class="container">
    {% block objectcontainer %}
    
    {% endblock %}
</div>
{% endblock %}